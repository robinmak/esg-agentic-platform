# Copy this file to `.env` and fill in your own keys. Do NOT commit `.env`.

# Required: OpenAI API key — used for the agent LLMs (gpt-4o-mini) and embeddings.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Required: Serper API key — used by the internet-search tool.
# https://serper.dev/
SERPER_API_KEY=your-serper-api-key-here

# Optional: Browserless API key — used by the browser-scraping tool.
# https://www.browserless.io/ (free tier available)
# BROWSERLESS_API_KEY=your-browserless-api-key-here

# Optional: SEC-API key — only needed if you enable SEC filing retrieval.
# https://sec-api.io/
# SEC_API_API_KEY=your-sec-api-key-here

# ---- Report document paths (optional) ------------------------------------
# The report PDFs are supplied by you and are not shipped with the repo.
# Set these to point the agents at your files, or pass them as CLI flags
# (main.py) / upload them in the Streamlit app instead.
# TCFD_SUSTAINABILITY_REPORT=./sustainability_report.pdf
# TCFD_ANNUAL_REPORT=./annual_report.pdf

# The TCFD rubric CSVs ship with the repo; override only if you move them.
# TCFD_CRITERIA_CSV=./tcfd_disclosure_criteria.csv
# TCFD_RUBRIC_CSV=./tcfd_disclosure_rubric.csv
# TCFD_GRADING_CSV=./tcfd_disclosure_grading.csv
